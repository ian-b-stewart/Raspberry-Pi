# Secrets directory - contains passwords, keys, and sensitive configuration
Backup/secrets/

# Environment files with real values (keep .example templates)
*.env
*.env.*
!*.env.example

# SSH keys
id_*
*.key
*.pem
*.ppk

# Credential stores and client authentication files
*.p12
*.pfx
*.jks
*.kdbx
.netrc
.npmrc
.pypirc
credentials.json
service-account*.json
acme.json

# GPG files
*.gpg

# Backup archives (if created locally)
*.tar.gz
*.tar

# Editor and OS files
.DS_Store
*.swp
*.swo
*~
.vscode/
*.bak

# Secret scanner output
gitleaks-report.*
